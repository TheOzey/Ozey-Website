# ─────────────────────────────────────────────────────────────────────────────
# Ozey Console — environment. Copy to `.env.local` (git-ignored).
#
# NEXT_PUBLIC_* values are Firebase *web client config*: public identifiers,
# not credentials. Never put a service-account key in any variable here or
# anywhere under src/. Server credentials come from Application Default
# Credentials (local: impersonation; Vercel: Workload Identity Federation).
# ─────────────────────────────────────────────────────────────────────────────

# ── Workforce identity (console sign-in) — "Ozey Workforce Dev" ─────────────
NEXT_PUBLIC_WORKFORCE_FIREBASE_API_KEY=
NEXT_PUBLIC_WORKFORCE_FIREBASE_AUTH_DOMAIN=project-5dedabbe-2c9d-433a-a40.firebaseapp.com
NEXT_PUBLIC_WORKFORCE_FIREBASE_PROJECT_ID=project-5dedabbe-2c9d-433a-a40
NEXT_PUBLIC_WORKFORCE_FIREBASE_APP_ID=
# Server-side (never NEXT_PUBLIC): the workforce project the session server uses.
WORKFORCE_PROJECT_ID=project-5dedabbe-2c9d-433a-a40
# How the server authenticates to it: adc (default; production) or gcloud
# (LOCAL DEV ONLY: tokens from `gcloud auth print-access-token`; refused in
# production and on Vercel). The dev project needs gcloud because its
# organization blocks the ADC sign-in route.
WORKFORCE_CREDENTIALS=gcloud
# Required with WORKFORCE_CREDENTIALS=gcloud: Google APIs need a quota project for user credentials.
GOOGLE_CLOUD_QUOTA_PROJECT=project-5dedabbe-2c9d-433a-a40

# ── Local workforce emulators instead (see workforce/README.md) ─────────────
# NEXT_PUBLIC_WORKFORCE_FIREBASE_API_KEY=demo-key
# NEXT_PUBLIC_WORKFORCE_FIREBASE_PROJECT_ID=demo-ozey-workforce
# NEXT_PUBLIC_WORKFORCE_FIREBASE_AUTH_DOMAIN=demo-ozey-workforce.firebaseapp.com
# NEXT_PUBLIC_WORKFORCE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# NEXT_PUBLIC_WORKFORCE_USE_EMULATORS=true
# WORKFORCE_PROJECT_ID=demo-ozey-workforce
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9299
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8280

# ── SHG product backend ──────────────────────────────────────────────────────
# Not used while SHG is "not connected" (src/modules/shg/connection.ts). Will be
# set when the short-lived shg:read credential exchange is built.
NEXT_PUBLIC_SHG_FIREBASE_API_KEY=
NEXT_PUBLIC_SHG_FIREBASE_AUTH_DOMAIN=ozey-shg.firebaseapp.com
NEXT_PUBLIC_SHG_FIREBASE_PROJECT_ID=ozey-shg
NEXT_PUBLIC_SHG_FIREBASE_APP_ID=
NEXT_PUBLIC_SHG_USE_EMULATORS=false
